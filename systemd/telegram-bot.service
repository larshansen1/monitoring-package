[Unit]
Description=Telegram Monitoring Bot Handler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/local/bin
ExecStart=/opt/telegram-bot/venv/bin/python3 /usr/local/bin/telegram-bot-handler.py
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=false
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-bot

[Install]
WantedBy=multi-user.target
