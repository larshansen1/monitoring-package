# Telegram Bot Configuration
#
# Setup:
#   1. cp telegram.conf.example telegram.conf
#   2. Fill in both values below
#   3. sudo ./install.sh   (installs it to /etc/monitoring/telegram.conf, mode 0600)
#
# telegram.conf is gitignored — never commit real credentials.

# Bot token from @BotFather (looks like 1234567890:AA...)
# Use a SEPARATE bot per server so you can tell alerts apart and revoke one
# without taking the others down.
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Your Telegram numeric chat ID. To find it: message your bot, then run
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | jq '.result[].message.chat.id'
# Only this chat ID is allowed to trigger runbooks.
TELEGRAM_CHAT_ID="your_chat_id_here"
